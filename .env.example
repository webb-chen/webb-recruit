# ===== 数据库配置 =====
# PostgreSQL数据库连接URL（异步驱动）
DATABASE_URL=postgresql+asyncpg://supin:supin123@postgres:5432/ai_supin

# ===== Redis配置 =====
# Redis连接URL，用于缓存和Celery消息队列
REDIS_URL=redis://redis:6379/0

# ===== JWT安全配置 =====
# JWT密钥（生产环境请务必更换为随机字符串）
SECRET_KEY=ai-supin-secret-key-2026-change-in-production

# JWT加密算法
ALGORITHM=HS256

# 访问令牌过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===== MinIO对象存储配置 =====
# MinIO服务地址（容器内通信使用服务名）
MINIO_ENDPOINT=minio:9000

# MinIO访问密钥
MINIO_ACCESS_KEY=minioadmin

# MinIO密钥
MINIO_SECRET_KEY=minioadmin123

# MinIO存储桶名称
MINIO_BUCKET_NAME=ai-supin

# 是否使用HTTPS连接MinIO
MINIO_SECURE=false

# ===== OpenAI配置 =====
# OpenAI API密钥（可选，不填则AI功能不可用）
OPENAI_API_KEY=

# OpenAI模型名称
OPENAI_MODEL=gpt-4o-mini

# OpenAI API基础URL（可替换为其他兼容接口）
OPENAI_BASE_URL=

# ===== 跨域配置 =====
# 允许的跨域来源（多个用逗号分隔）
CORS_ORIGINS=*

# ===== 应用配置 =====
# 应用名称
APP_NAME=AI速聘招聘自动化系统

# 应用版本
APP_VERSION=1.0.0

# 调试模式（生产环境设为false）
DEBUG=true
